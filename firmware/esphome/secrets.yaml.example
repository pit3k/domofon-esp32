# Copy to secrets.yaml (git-ignored) and fill in your values.
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"
ha_url: "http://homeassistant.local:8123"
ha_token: "LONG_LIVED_ACCESS_TOKEN"
intercom__ap_password: "FALLBACK_AP_PASSWORD"
intercom__encryption_key: "BASE64_32_BYTE_KEY"   # openssl rand -base64 32
